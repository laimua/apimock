# 环境变量配置

# 数据库类型: sqlite | mysql | turso
DB_TYPE=sqlite

# SQLite 配置（DB_TYPE=sqlite 时使用）
SQLITE_PATH=./data/apimock.db

# MySQL 配置（DB_TYPE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=apimock

# Turso 配置（DB_TYPE=turso 时使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI Provider（选择一个或两个）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api