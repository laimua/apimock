# 环境变量配置
# 所有未标注"必填"的变量留空即用默认值，对应功能关闭。

# ─── 数据库 ─────────────────────────────────────────────
# 类型: sqlite | mysql （turso 旧值已弃用）
DB_TYPE=sqlite

# SQLite（DB_TYPE=sqlite 时使用）
SQLITE_PATH=./data/apimock.db

# MySQL（DB_TYPE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=apimock

# ─── 安全（必填）─────────────────────────────────────────
# AES-256-GCM 加密密钥，加密 AI provider API key。
# 丢失后所有 provider key 不可恢复（代码无兜底），密码管理器留备份。
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=

# ─── AI Provider（任一即可）──────────────────────────────
# 1) 环境变量兜底（无 provider 配置时用此 key + OPENAI_FALLBACK_MODEL）
OPENAI_API_KEY=
OPENAI_FALLBACK_MODEL=gpt-4o-mini

# 2) 页面配置访问 /settings/ai 添加 provider（推荐）
ANTHROPIC_API_KEY=

# AI 日预算兜底（PRD 头号风险：AI 成本失控，超额降级到本地 mock 模板）
# 默认 1_000_000 tokens / 日，1000 次 / 日
AI_DAILY_TOKEN_LIMIT=1000000
AI_DAILY_REQUEST_LIMIT=1000

# ─── KV 后端（多副本必填）────────────────────────────────
# 单实例留空走 Memory（精确）。多副本配 Redis URL 共享限流 + AI 预算。
# 初始化失败自动 fallback Memory（warn log）。
REDIS_URL=
# 例：redis://default:password@host:6379

# ─── 可观测性 ────────────────────────────────────────────
# 结构化日志级别（pino）：trace/debug/info/warn/error
LOG_LEVEL=info

# Prometheus metrics 端点（GET /api/metrics）
# 留空 → 端点返 503（避免业务 label 泄漏）
# 抓取时头：Authorization: Bearer <METRICS_TOKEN>
METRICS_TOKEN=

# OpenTelemetry APM（自动 instrument http/db/ioredis）
# 留空 → SDK 不启动，零开销
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_SERVICE_NAME=apimock
# 多头用逗号分隔：key1=val1,key2=val2
OTEL_EXPORTER_OTLP_HEADERS=

# ─── 备份（SQLite 模式）─────────────────────────────────
# ADMIN_TOKEN 仅用于备份触发（机器调用，X-Admin-Token header）
# ADMIN_TOKEN 留空 → POST /api/admin/backup 返 503
# 触发：curl -X POST -H "X-Admin-Token: $ADMIN_TOKEN" https://app/api/admin/backup
# 建议外部 cron：Railway cron service / GitHub Actions scheduled
ADMIN_TOKEN=
BACKUP_DIR=./data/backups
BACKUP_KEEP=7

# ─── 管理面鉴权（G1）─────────────────────────────────────
# MANAGE_TOKEN 用于管理面登录（人工，浏览器 cookie）。
# 与 ADMIN_TOKEN 独立：轮换管理密码不影响备份 cron，反之亦然。
# 留空 → 管理页面/API 返 503（fail-closed，对齐 metrics/backup 语义）。
# 安全要求：建议 >= 32 字符 CSPRNG 随机串（如 openssl rand -hex 32）；
# 短于 32 字符仍可运行，但启动时打 security warn（demo 可用弱值，生产勿复用）。
# 登录：访问 /projects 等管理页 → 跳 /login → 输入 MANAGE_TOKEN → 种 cookie（1 天）
# 机器客户端（agent / 脚本 / CI）：Authorization: Bearer <MANAGE_TOKEN> 直通，
# 无需登录拿 cookie（见 skills/apimock/）。
MANAGE_TOKEN=

# ─── Analytics（可选）────────────────────────────────────
# Plausible Cloud: 填域名（如 demo.apimock.io）；self-host: 填实例域名
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# ─── 应用 ────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# 调试：DB_LOG_SQL=true 开 SQL 日志（默认关，mock 路由 SQL 噪音大）
DB_LOG_SQL=

# 种子数据控制
# SKIP_SEED=true 禁用 auto-seed demo-project
# 默认：production 首次启动自动 seed
SKIP_SEED=
