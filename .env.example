# 环境变量配置

# 数据库类型: sqlite | mysql | turso
DB_TYPE=sqlite

# SQLite 配置（DB_TYPE=sqlite 时使用）
SQLITE_PATH=./data/apimock.db

# MySQL 配置（DB_TYPE=mysql 时使用）
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DATABASE=apimock

# Turso 配置（DB_TYPE=turso 时使用）
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# AI Provider（选择一个或两个）
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# 应用配置
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# 加密密钥（必填，AES-256-GCM 加密 AI provider API key）
# 生成：openssl rand -hex 32
ENCRYPTION_KEY=

# Analytics（可选，留空则禁用埋点）
# Plausible Cloud: 填 demo 域名，如 demo.apimock.io
# Self-host: 填你的 Plausible 实例域名
NEXT_PUBLIC_PLAUSIBLE_DOMAIN=

# 种子数据控制（可选）
# SKIP_SEED=true 可禁用 auto-seed demo-project
# 默认：production 首次启动自动 seed
SKIP_SEED=